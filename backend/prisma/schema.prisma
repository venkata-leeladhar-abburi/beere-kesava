// Beere Kesava & Brothers Silks ERP — backend schema
// Source of truth: Backend_Architecture_Design.pdf, Section 4 (Core Data Model)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SUPERADMIN
  WORKER
  WEAVER
  SHOP
  ACCOUNTANT
}

enum AccessLevel {
  FULL_ACCESS
  RESTRICTED
  DOWNLOAD_RESTRICTED
  MONEY_HIDDEN
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum LoomStatus {
  ACTIVE
  IDLE
  MAINTENANCE
}

enum BatchStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum RecipientType {
  WEAVER
  FACTORY_LOOM
}

enum MaterialType {
  WARP
  RESHAM
  JARI
}

enum WarpSubtype {
  RESHAM_WARP
  JARI_WARP
}

enum JariGrade {
  G1
  G2
  G3
  G4
  G5
}

enum SignatureMethod {
  HERE
  REMOTE
}

enum MaterialIssueStatus {
  PENDING_SIGNATURE
  SIGNED
  CANCELLED
}

enum QcResult {
  PASSED
  SEMI
  DEFECTIVE
}

enum FinishingAssignmentStatus {
  AWAITING_RETURN
  RETURNED
}

enum FinishingCondition {
  PERFECT
  DAMAGED
}

enum DamageSeverity {
  MINOR
  MODERATE
  SEVERE
}

enum QuotationStatus {
  RAISED
  IN_FINISHING
  PARTIALLY_RECEIVED
  RECEIVED
  DISPATCHED
}

enum QuotationSareeStatus {
  PENDING
  IN_FINISHING
  RECEIVED
}

enum BulkOrderStatus {
  ON_TRACK
  AT_RISK
  OVERDUE
}

enum DispatchStatus {
  PENDING
  DISPATCHED
  INVOICED
}

enum OrderPaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum DispatchType {
  SHOP
  WHOLESALE
}

enum InventoryStatus {
  QC_PASSED
  FINISHING_COMPLETE
  DISPATCHED
  DAMAGED_REVIEW_NEEDED
  SOLD
}

enum InventoryRawType {
  READY_SAREE
  RETURN
}

enum SareeOrigin {
  WEAVER
  FACTORY_LOOM
  EXTERNAL
}

enum SareeStatus {
  UNSOLD
  RETAIL
  WHOLESALE
  RETURNED
}

enum SalesChannel {
  RETAIL
  WHOLESALE
}

enum PartyStatus {
  ACTIVE
  INACTIVE
  OVERDUE
}

enum PurchasePaymentStatus {
  PAID
  PENDING
  PARTIAL
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
}

enum VendorBillStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupplierReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FinancialEntryKind {
  INCOME
  EXPENSE
  MISC
}

enum InvoiceStatus {
  PAID
  PARTIAL
  PENDING
  OVERDUE
}

enum CustomerType {
  WHOLESALE
  RETAIL
}

enum AuditStatus {
  LOGIN
  LOGOUT
  FAILED
}

enum NotificationTargetType {
  USER
  ROLE
}

enum WarpRequestStatus {
  PENDING
  APPROVED
  REJECTED
  // Set once an admin has actually issued the material against an APPROVED
  // request (MaterialIssuesService.create) — distinguishes "approved,
  // waiting to be issued" from "already fulfilled".
  ISSUED
}

enum RateRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// ─────────────────────────────────────────────────────────────────────────
// ID generation — DB-side counters so business IDs (EMP-NNN, PO-2026-NNN, ...)
// never collide, per Backend_Architecture_Design.pdf §6.1.
// ─────────────────────────────────────────────────────────────────────────

model IdCounter {
  prefix String @id // e.g. "EMP", "PO-2026", "ORD-2026", "MIR-2026"
  value  Int    @default(0)
}

// ─────────────────────────────────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "po.approve", "finance.view_amounts"
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model UserPermissionOverride {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean

  @@unique([userId, permissionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────────────────

model User {
  id          String       @id @default(uuid())
  empId       String       @unique // EMP-NNN
  firstName   String
  lastName    String
  mobile      String       @unique
  email       String?
  role        UserRole
  accessLevel AccessLevel  @default(FULL_ACCESS)
  status      ActiveStatus @default(ACTIVE)
  dateAdded   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Set when this User's role is WEAVER — links to the actual Weaver record
  // auto-created alongside it, so the roster shows up in the Weavers module
  // instead of only existing as an invisible User row.
  linkedWeaverId String? @unique
  linkedWeaver   Weaver? @relation(fields: [linkedWeaverId], references: [id])

  permissionOverrides  UserPermissionOverride[]
  whatsappMessages     WhatsAppMessage[]
  auditLogs            AuditLog[]
  actionLogs           ActionLog[]
  notifications        Notification[]
  issuedMaterialIssues MaterialIssueRecord[]    @relation("IssuedBy")
  receivedMaterialReturns MaterialReturnRecord[] @relation("ReceivedBy")
  addedPurchases       Purchase[]               @relation("PurchaseAddedBy")
  inspectedQcRecords   QcRecord[]               @relation("InspectedBy")
  assignedFinishings   FinishingAssignment[]    @relation("AssignedBy")
  raisedQuotations     Quotation[]              @relation("RaisedBy")
  requestedPurchases   PurchaseRequest[]        @relation("RequestedBy")
  decidedPurchases     PurchaseRequest[]        @relation("DecidedBy")
  decidedWarpRequests  WarpRequest[]            @relation("DecidedWarpRequests")
  requestedRateChanges RateChangeRequest[]     @relation("RequestedRateChanges")
  decidedRateChanges   RateChangeRequest[]     @relation("DecidedRateChanges")
  reportDownloads      ReportDownloadHistory[]
  createdPurchaseOrders PurchaseOrder[]
  receivedGrnReceipts  GrnReceipt[]
  requestedSupplierReturns SupplierReturnRequest[] @relation("RequestedSupplierReturns")
  decidedSupplierReturns   SupplierReturnRequest[] @relation("DecidedSupplierReturns")

  @@index([role])
}

model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
}

// ─────────────────────────────────────────────────────────────────────────
// WhatsApp (AiSensy)
// ─────────────────────────────────────────────────────────────────────────

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppMessageKind {
  OTP
  DOCUMENT
  REPORT
  RETAIL_BILL
  MANUAL
}

model WhatsAppMessage {
  id             String                @id @default(uuid())
  kind           WhatsAppMessageKind
  campaignName   String
  destination    String
  templateParams Json?
  mediaUrl       String?
  status         WhatsAppMessageStatus @default(QUEUED)
  providerId     String?
  errorMessage   String?
  attempts       Int                   @default(0)

  relatedType String?
  relatedId   String?
  sentById    String?
  sentBy      User?   @relation(fields: [sentById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destination])
  @@index([status])
  @@index([relatedType, relatedId])
}

// ─────────────────────────────────────────────────────────────────────────
// Production masters
// ─────────────────────────────────────────────────────────────────────────

model Weaver {
  id        String       @id @default(uuid())
  // Human-facing weaver ID (e.g. "Wea-001") — gap-filled against the count of
  // existing weavers, not a monotonic counter: deleting a weaver frees its
  // number for the next one created. Distinct from `id` (UUID), which is the
  // real FK target everywhere else and never changes.
  code      String       @unique
  name      String
  firstName String
  lastName  String
  initials  String // derived, used in saree ID e.g. RAVI
  village   String?
  cluster   String?
  looms     Int          @default(0)
  status    ActiveStatus @default(ACTIVE)
  photoUrl  String
  email     String
  phone     String
  bankName  String?
  accountNo String?
  ifsc      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  designs        DesignLibrary[]
  batchSareeRows BatchSareeRow[]
  materialIssues MaterialIssueRecord[]
  materialReturns MaterialReturnRecord[]
  qcRecords      QcRecord[]
  sarees         Saree[]
  payments       WeaverPayment[]
  warpRequests   WarpRequest[]
  linkedUser     User?

  @@index([status])
}

model FactoryLoom {
  id            String     @id @default(uuid())
  // Human-facing sequential id (e.g. "Loom-001") — generated via
  // IdGeneratorService, distinct from `id` (UUID), which stays the real FK
  // target everywhere else. `loomNumber` is the operator's own label for the
  // machine ("Loom F-06") and is separate from this code.
  code          String?    @unique
  loomNumber    String     @unique // BKB-F-0X
  // Retained for existing rows; no longer collected when adding a loom.
  location      String?
  operatorName  String?
  operatorPhone String?
  status        LoomStatus @default(ACTIVE)
  installedYear Int?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  batchSareeRows BatchSareeRow[]
  materialIssues MaterialIssueRecord[]
  materialReturns MaterialReturnRecord[]
  qcRecords      QcRecord[]
  sarees         Saree[]

  @@index([status])
}

model DesignLibrary {
  code              String   @id
  name              String
  typeCode          String
  typeName          String
  description       String?
  color             String?
  weaverId          String?
  weaver            Weaver?  @relation(fields: [weaverId], references: [id])
  notesForWeaver    String?
  colorSlipPhotoUrl String?
  designGraphUrl    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  batchSareeRows BatchSareeRow[]
  sarees         Saree[]
}

model DesignDispatch {
  id                 String        @id
  recipientType      RecipientType
  recipientId        String        // weaver id or loom number string
  recipientName      String
  instructions       String
  colorSlipImageUrl  String?
  designGraphImageUrl String?
  batches            String[]      // array of batch IDs
  sentAt             DateTime      @default(now())
}


model SareeTypeRate {
  code           String   @id
  type           String
  description    String?
  makingCharge   Decimal  @db.Decimal(12, 2)
  retailPrice    Decimal  @db.Decimal(12, 2)
  wholesalePrice Decimal  @db.Decimal(12, 2)
  stdWeightG     Decimal  @db.Decimal(10, 2)
  warpWeightG    Decimal  @db.Decimal(10, 2)
  reshamWeightG  Decimal  @db.Decimal(10, 2)
  jariWeightG    Decimal  @db.Decimal(10, 2)
  updatedAt      DateTime @updatedAt

  batchSareeRows BatchSareeRow[]
  sarees         Saree[]
  rateRequests   RateChangeRequest[]
}

// ─────────────────────────────────────────────────────────────────────────
// Production — batches
// ─────────────────────────────────────────────────────────────────────────

model Batch {
  id         String      @id // business key, e.g. BATCH-2026-001
  totalCount Int
  dueDate    DateTime
  status     BatchStatus @default(DRAFT)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  rows             BatchSareeRow[]
  materialIssues   MaterialIssueRecord[]
  materialReturns  MaterialReturnRecord[]
  sarees           Saree[]
  inventoryRecords InventoryRecord[]
}

model BatchSareeRow {
  id            String        @id @default(uuid())
  batchId       String
  batch         Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  serial        Int
  sareeId       String?        @unique
  // Nullable: a batch is created with N empty slots up front and each row is
  // assigned a recipient/design/type afterward (see architecture doc — rows
  // exist unassigned in draft batches until dispatched to a weaver/loom).
  recipientType RecipientType?
  weaverId      String?
  weaver        Weaver?        @relation(fields: [weaverId], references: [id])
  factoryLoomId String?
  factoryLoom   FactoryLoom?   @relation(fields: [factoryLoomId], references: [id])
  designCode    String?
  design        DesignLibrary? @relation(fields: [designCode], references: [code])
  sareeTypeCode String?
  sareeType     SareeTypeRate? @relation(fields: [sareeTypeCode], references: [code])
  bulkOrderRef  String?
  bulkOrder     BulkOrder?     @relation(fields: [bulkOrderRef], references: [ref])
  qcPassed      Boolean?
  createdAt     DateTime      @default(now())

  // Set when Worker Staff physically receives the finished saree from the
  // weaver/loom — a row must be received before it enters the QC queue.
  receivedAt     DateTime?
  receivedWeight Decimal?  @db.Decimal(8, 2)
  receivedColor  String?
  receivedPhotoUrl String?
  // Actual material split entered at receipt (grams for warp/resham, reels
  // for jari) — defaults to the rate card's standard split scaled to the
  // entered weight, but Worker Staff can override it. Persisted separately
  // from receivedWeight so a bulk order's material tally reflects what was
  // actually recorded, not a re-derived estimate.
  receivedWarpG      Decimal? @db.Decimal(8, 2)
  receivedReshamG    Decimal? @db.Decimal(8, 2)
  receivedJariReels  Decimal? @db.Decimal(8, 2)
  // Retail selling price Worker Staff enters for THIS specific saree at
  // receipt, overriding the saree type's shared SareeTypeRate.retailPrice —
  // null until received, and null forever for a saree received before this
  // field existed (the New Sale flow falls back to the type rate then).
  receivedSellingPrice Decimal? @db.Decimal(12, 2)

  // Admin's physical-count verification of this one saree, separate from
  // BulkOrder.tallied (which only confirms the order's overall saree count).
  // This is the per-saree weight/material check — admin compares what
  // Worker Staff entered at receipt against the SareeTypeRate standard.
  tallied   Boolean   @default(false)
  talliedBy String?
  talliedAt DateTime?

  // History: a saree can be re-inspected after a SEMI verdict sends it back
  // to the weaver for rework, so this is one-to-many, newest last by qcDate.
  qcRecords            QcRecord[]
  finishingAssignment  FinishingAssignment?

  @@unique([batchId, serial])
  @@index([weaverId])
  @@index([factoryLoomId])
}

// ─────────────────────────────────────────────────────────────────────────
// Material issue
// ─────────────────────────────────────────────────────────────────────────

model MaterialIssueRecord {
  id                 String              @id // MIR-2026-NNN
  weaverId           String?
  weaver             Weaver?             @relation(fields: [weaverId], references: [id])
  factoryLoomId      String?
  factoryLoom        FactoryLoom?        @relation(fields: [factoryLoomId], references: [id])
  loomNumber         String?
  batchId            String?
  batch              Batch?              @relation(fields: [batchId], references: [id])
  issuedById         String
  issuedBy           User                @relation("IssuedBy", fields: [issuedById], references: [id])
  issuedAt           DateTime            @default(now())
  signatureMethod    SignatureMethod?
  signatureCaptured  Boolean             @default(false)
  signatureTimestamp DateTime?
  signatureUrl       String?
  status             MaterialIssueStatus @default(PENDING_SIGNATURE)
  notes              String?
  // Set when this issuance fulfils an approved WarpRequest — lets the Issue
  // Material page's "Approved Warp Requests" queue know it's been handled.
  warpRequestId      String?             @unique
  warpRequest        WarpRequest?        @relation(fields: [warpRequestId], references: [id])

  items MaterialIssueItem[]

  @@index([weaverId])
  @@index([factoryLoomId])
}

model MaterialIssueItem {
  id           String              @id @default(uuid())
  issueId      String
  issue        MaterialIssueRecord @relation(fields: [issueId], references: [id], onDelete: Cascade)
  materialType MaterialType
  warpSubtype  WarpSubtype?
  quantity     Decimal             @db.Decimal(12, 3)
  unit         String
  jariType     String?
  jariGrade    JariGrade?
  jariColor    String?
  // The parent GRN receipt this material came from (e.g.
  // "GRN-SreeVignesh-004-002").
  grnBatchId   String?
  // The specific GrnItem line within that receipt (see GrnItem.itemCode,
  // e.g. "GRN-SreeVignesh-004-002-1"). Issuing used to be tracked only at
  // (grnBatchId, materialType) granularity, which could not tell two lines
  // of the same material type apart and left the ids shown on Issue
  // Material inconsistent with the ones on Receive Stock. Nullable: rows
  // issued before this existed have none and still fall back to the old
  // material-type matching.
  grnItemId    String?
  grnItem      GrnItem?            @relation(fields: [grnItemId], references: [id])

  @@index([issueId])
  @@index([grnItemId])
}

// ─────────────────────────────────────────────────────────────────────────
// Material return
// ─────────────────────────────────────────────────────────────────────────

enum MaterialReturnStatus {
  PENDING_SIGNATURE
  APPROVED
  CANCELLED
}

model MaterialReturnRecord {
  id                 String               @id // MRR-2026-NNN
  weaverId           String?
  weaver             Weaver?              @relation(fields: [weaverId], references: [id])
  factoryLoomId      String?
  factoryLoom        FactoryLoom?         @relation(fields: [factoryLoomId], references: [id])
  loomNumber         String?
  batchId            String?
  batch              Batch?               @relation(fields: [batchId], references: [id])
  receivedById       String
  receivedBy         User                 @relation("ReceivedBy", fields: [receivedById], references: [id])
  receivedAt         DateTime             @default(now())
  signatureMethod    SignatureMethod?
  signatureCaptured  Boolean              @default(false)
  signatureTimestamp DateTime?
  signatureUrl       String?
  status             MaterialReturnStatus @default(PENDING_SIGNATURE)
  deductionAmount    Decimal?             @db.Decimal(12, 2)
  deductionReason    String?
  notes              String?

  items MaterialReturnItem[]

  @@index([weaverId])
  @@index([factoryLoomId])
}

model MaterialReturnItem {
  id           String               @id @default(uuid())
  returnId     String
  return       MaterialReturnRecord @relation(fields: [returnId], references: [id], onDelete: Cascade)
  materialType MaterialType
  warpSubtype  WarpSubtype?
  quantity     Decimal              @db.Decimal(12, 3)
  unit         String
  jariType     String?
  jariGrade    JariGrade?
  jariColor    String?

  @@index([returnId])
}

// ─────────────────────────────────────────────────────────────────────────
// QC
// ─────────────────────────────────────────────────────────────────────────

model QcRecord {
  id            String        @id @default(uuid())
  // Not unique — a saree can accumulate multiple QC records over successive
  // SEMI-rework rounds. Always read the latest by qcDate as "current".
  sareeId       String
  batchSareeRow BatchSareeRow @relation(fields: [sareeId], references: [sareeId])
  weaverId      String?
  weaver        Weaver?       @relation(fields: [weaverId], references: [id])
  factoryLoomId String?
  factoryLoom   FactoryLoom?  @relation(fields: [factoryLoomId], references: [id])
  batchId       String?
  loomNumber    String?
  result        QcResult
  defects       String[]
  makingCharge  Decimal       @db.Decimal(12, 2)
  deduction     Decimal       @default(0) @db.Decimal(12, 2)
  payable       Decimal       @db.Decimal(12, 2)
  receivedDate  DateTime?
  qcDate        DateTime      @default(now())
  photoUrl      String?
  notes         String?
  inspectedById String
  inspectedBy   User          @relation("InspectedBy", fields: [inspectedById], references: [id])

  @@index([sareeId])
  @@index([weaverId])
  @@index([factoryLoomId])
  @@index([result])
}

// ─────────────────────────────────────────────────────────────────────────
// Finishing
// ─────────────────────────────────────────────────────────────────────────

model FinishingStaff {
  id             String       @id @default(uuid())
  empId          String       @unique
  firstName      String
  lastName       String
  mobile         String
  email          String?
  specialisation String?
  notes          String?
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  assignments FinishingAssignment[]
}

model FinishingAssignment {
  id               String                    @id @default(uuid())
  sareeId          String                    @unique
  batchSareeRow    BatchSareeRow             @relation(fields: [sareeId], references: [sareeId])
  designCode       String?
  sareeType        String?
  finishingStaffId String
  finishingStaff   FinishingStaff            @relation(fields: [finishingStaffId], references: [id])
  assignedById     String
  assignedBy       User                      @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedDate     DateTime                  @default(now())
  status           FinishingAssignmentStatus @default(AWAITING_RETURN)
  condition        FinishingCondition?
  damageType       String?
  damageSeverity   DamageSeverity?
  damageNotes      String?
  damagePhotoUrl   String?
  quotationRef     String?
  quotation        Quotation?                @relation(fields: [quotationRef], references: [id])
  updatedAt        DateTime                  @default(now()) @updatedAt

  @@index([sareeId])
  @@index([finishingStaffId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Quotations
// ─────────────────────────────────────────────────────────────────────────

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  quotationDate   DateTime        @default(now())
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  bulkOrderRef    String?
  bulkOrder       BulkOrder?      @relation(fields: [bulkOrderRef], references: [ref])
  applyGst        Boolean         @default(false)
  gstPct          Decimal?        @db.Decimal(5, 2)
  subtotal        Decimal         @db.Decimal(12, 2)
  grandTotal      Decimal         @db.Decimal(12, 2)
  firmId          String?
  firm            Firm?           @relation(fields: [firmId], references: [id])
  status          QuotationStatus @default(RAISED)
  raisedById      String
  raisedBy        User            @relation("RaisedBy", fields: [raisedById], references: [id])
  createdAt       DateTime        @default(now())

  sarees               QuotationSaree[]
  finishingAssignments FinishingAssignment[]
}

model QuotationSaree {
  id              String               @id @default(uuid())
  quotationId     String
  quotation       Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sareeId         String
  finishingStatus QuotationSareeStatus @default(PENDING)
  price           Decimal              @db.Decimal(12, 2)

  @@unique([quotationId, sareeId])
}

// ─────────────────────────────────────────────────────────────────────────
// Sales — Bulk orders, dispatch, unified sarees
// ─────────────────────────────────────────────────────────────────────────

model BulkOrder {
  ref             String             @id // ORD-2026-NNN
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  dueDate         DateTime
  createdDate     DateTime           @default(now())
  status          BulkOrderStatus    @default(ON_TRACK)
  sareeTypeCode   String?
  designCode      String?
  total           Int
  done            Int                @default(0)
  shortage        Int                @default(0)
  dispatchStatus  DispatchStatus     @default(PENDING)
  paymentStatus   OrderPaymentStatus @default(PENDING)
  amountDue       Decimal            @db.Decimal(12, 2)
  amountPaid      Decimal            @default(0) @db.Decimal(12, 2)
  gstCode         String?
  address         String?
  phone           String?
  visitingCardUrl String?
  photoUrls       String[]
  tallied         Boolean            @default(false)
  talliedBy       String?
  talliedDate     DateTime?

  batchSareeRows   BatchSareeRow[]
  quotations       Quotation[]
  dispatchRecords  DispatchRecord[]
  inventoryRecords InventoryRecord[]

  @@index([status])
  @@index([customerId])
}

model DispatchRecord {
  id               String       @id @default(uuid())
  type             DispatchType
  dispatchDate     DateTime     @default(now())
  lrNumber         String?
  transportCompany String?
  vehicleNumber    String?
  driverName       String?
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id])
  invoiceNumber    String?
  invoiceDate      DateTime?
  pricePerSaree    Decimal?     @db.Decimal(12, 2)
  totalAmount      Decimal      @db.Decimal(12, 2)
  gstPct           Decimal?     @db.Decimal(5, 2)
  grandTotal       Decimal      @db.Decimal(12, 2)
  firmId           String?
  firm             Firm?        @relation(fields: [firmId], references: [id])
  paymentDueDate   DateTime?
  bulkOrderRef     String?
  bulkOrder        BulkOrder?   @relation(fields: [bulkOrderRef], references: [ref])
  quotationRef     String?
  // "Skip transport/invoicing details for now, dispatch anyway, fill them in
  // later" — matches the frontend's ResumeDispatchModal / DispatchDetailsModal flow.
  pendingTransport Boolean      @default(false)
  pendingReceipt   Boolean      @default(false)
  // Server-relative path to the uploaded LR receipt (POST /uploads/receipt).
  // Null while pendingReceipt is still true.
  receiptUrl       String?
  notes            String?
  // Wholesale-only fields from TransportForm — expectedDelivery mirrors
  // dispatchDate's shape (a plain date), specialInstructions replaces
  // `notes` in that form's UI (retail dispatch uses `notes` instead).
  expectedDelivery   DateTime?
  specialInstructions String?

  sarees  DispatchSaree[]
  invoice Invoice?

  @@index([paymentDueDate])
  @@index([customerId])
}

model DispatchSaree {
  id         String         @id @default(uuid())
  dispatchId String
  dispatch   DispatchRecord @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  sareeId    String

  @@unique([dispatchId, sareeId])
}

model InventoryRecord {
  sareeId      String           @id
  status       InventoryStatus
  rawType      InventoryRawType
  bulkOrderRef String?
  bulkOrder    BulkOrder?       @relation(fields: [bulkOrderRef], references: [ref])
  batchId      String?
  batch        Batch?           @relation(fields: [batchId], references: [id])
  quotationRef String?
  updatedAt    DateTime         @updatedAt

  @@index([status])
}

model Saree {
  id            String         @id // canonical saree ID
  origin        SareeOrigin
  weaverId      String?
  weaver        Weaver?        @relation(fields: [weaverId], references: [id])
  factoryLoomId String?
  factoryLoom   FactoryLoom?   @relation(fields: [factoryLoomId], references: [id])
  purchaseId    String?
  purchase      Purchase?      @relation(fields: [purchaseId], references: [id])
  batchId       String?
  batch         Batch?         @relation(fields: [batchId], references: [id])
  designCode    String?
  design        DesignLibrary? @relation(fields: [designCode], references: [code])
  sareeTypeCode String?
  sareeType     SareeTypeRate? @relation(fields: [sareeTypeCode], references: [code])
  weightG       Decimal?       @db.Decimal(10, 2)
  costPrice     Decimal?       @db.Decimal(12, 2)
  // Free-text descriptors, set only for pieces registered by hand rather than
  // produced through the batch pipeline — a wholesale return arrives with no
  // barcode, so the operator's description is the only record of it. Same
  // pattern (and spelling) as PurchaseSareeLine.color/sareeType.
  color         String?
  // Where a hand-registered piece came from, when it is not a Vendor/Supplier
  // record — e.g. the wholesale customer named on a return.
  sourceName    String?
  qcDate        DateTime?
  status        SareeStatus    @default(UNSOLD)
  createdAt     DateTime       @default(now())

  sales   SaleRecord[]
  returns ReturnRecord[]

  @@index([status])
  @@index([weaverId])
  @@index([factoryLoomId])
}

model SaleRecord {
  saleRef    String       @id
  sareeId    String
  saree      Saree        @relation(fields: [sareeId], references: [id])
  channel    SalesChannel
  date       DateTime     @default(now())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  amount     Decimal      @db.Decimal(12, 2)

  @@index([sareeId])
}

model ReturnRecord {
  returnRef    String   @id
  sareeId      String
  saree        Saree    @relation(fields: [sareeId], references: [id])
  reason       String?
  refundAmount Decimal? @db.Decimal(12, 2)
  restocked    Boolean  @default(false)
  // Server-relative path to the condition photo taken at return time
  // (POST /uploads/photo). Optional — the operator may skip it.
  photoUrl     String?
  createdAt    DateTime @default(now())

  @@index([sareeId])
}

// ─────────────────────────────────────────────────────────────────────────
// Procurement
// ─────────────────────────────────────────────────────────────────────────

model Supplier {
  id          String      @id @default(uuid())
  // Human-facing sequential id (e.g. "SUPPLIER-001") — generated via
  // IdGeneratorService.nextFormatted("SUPPLIER"), distinct from `id` (UUID),
  // which stays the real FK target everywhere else.
  code        String?     @unique
  name        String
  initials    String?
  contactName String?
  phone       String?
  whatsapp    String?
  city        String?
  state       String?
  address     String?
  gstCode     String?
  specialty   String?
  terms       String?
  bankName    String?
  accountNo   String?
  ifscCode    String?
  notes       String?
  // Stored path of the visiting-card photo (POST /uploads/photo),
  // matching Customer.visitingCardUrl. Never a base64 data URL.
  visitingCardUrl String?
  status      PartyStatus @default(ACTIVE)
  rating      Int?
  createdAt   DateTime    @default(now())

  purchases        Purchase[]
  purchaseRequests PurchaseRequest[]
  payments         SupplierPayment[]
  returnRequests   SupplierReturnRequest[]
}

model SupplierPayment {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime @default(now())
  utr        String?
  method     String?
  firmId     String?
  firm       Firm?    @relation(fields: [firmId], references: [id])

  @@index([supplierId])
}

model Vendor {
  id          String      @id @default(uuid())
  // Human-facing sequential id (e.g. "VENDOR-001") — generated via
  // IdGeneratorService.nextFormatted("VENDOR"), distinct from `id` (UUID),
  // which stays the real FK target everywhere else.
  code        String?     @unique
  name        String
  initials    String?
  contactName String?
  phone       String?
  whatsapp    String?
  city        String?
  state       String?
  address     String?
  gstCode     String?
  specialty   String?
  terms       String?
  bankName    String?
  accountNo   String?
  ifscCode    String?
  notes       String?
  // Stored path of the visiting-card photo (POST /uploads/photo),
  // matching Customer.visitingCardUrl. Never a base64 data URL.
  visitingCardUrl String?
  status      PartyStatus @default(ACTIVE)
  rating      Int?
  createdAt   DateTime    @default(now())

  purchaseOrders PurchaseOrder[]
  vendorPayments VendorPayment[]
  vendorBills    VendorBill[]
  rawStock       RawMaterialStock[]
  grnReceipts    GrnReceipt[]
}

model Purchase {
  id            String                @id // EXT-2026-NNN
  // Optional so an unregistered ("Other, enter manually") supplier can still
  // be recorded — supplierName/location carry the free-text entry in that
  // case. Exactly one of supplierId/supplierName must be set (enforced in
  // PurchasesService.create).
  supplierId    String?
  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  supplierName  String?
  location      String?
  date          DateTime              @default(now())
  sareeCount    Int
  gstNumber     String?
  invoiceNumber String?
  billAmount    Decimal               @db.Decimal(12, 2)
  status        PurchasePaymentStatus @default(PENDING)
  notes         String?
  invoiceFileName String?
  addedById     String?
  addedBy       User?                 @relation("PurchaseAddedBy", fields: [addedById], references: [id])
  createdAt     DateTime              @default(now())

  sarees     Saree[]
  sareeLines PurchaseSareeLine[]
  supplierReturnRequests SupplierReturnRequest[]

  @@index([supplierId])
}

// One line of a Purchase's per-saree detail (SareeTag on the frontend) — the
// rich pricing/weight/photo entry the External Purchases form captures per
// physical saree bought, distinct from `Purchase.sarees` (real production
// Saree rows, a separate and currently unpopulated concern).
model PurchaseSareeLine {
  id          String   @id @default(uuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  // Human-facing line code, e.g. RAVI-INV118-003 — computed client-side
  // (buildSareeCode) and passed through; never regenerated server-side once set.
  code        String
  weight      String?
  // Renamed from the frontend's `date` (which is per-line, defaulting to the
  // purchase date) to avoid confusion with Purchase.date.
  sareeDate   DateTime?
  sareeType   String?
  color       String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  sellPercent Decimal  @default(0) @db.Decimal(6, 2)
  quantity    Int      @default(1)
  finalAmount Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?
  // Photo of the saree — the frontend currently captures this as a data URL,
  // so it's stored as-is rather than uploaded to disk (see common/storage
  // for the disk-upload pattern used elsewhere, if this ever needs it).
  imageUrl    String?  @db.Text
  // How many of this line's `quantity` pieces have been returned to the
  // supplier — a line covers N identical physical sarees, so return status
  // is tracked as a count rather than a per-piece flag; the frontend treats
  // the first `returnedQuantity` expanded pieces of the line as returned.
  returnedQuantity Int @default(0)

  supplierReturnRequests SupplierReturnRequest[]

  @@index([purchaseId])
}

// A request to send purchased sarees back to the supplier. Approval is a
// separate step from the request itself (mirrors PurchaseRequest): the pieces
// stay counted as on-hand stock until an admin approves, at which point
// PurchaseSareeLine.returnedQuantity is incremented — which is what already
// drives "Returned" in the External Purchases saree list — and the request
// becomes the permanent record in the Supplier Returns section.
model SupplierReturnRequest {
  id            String               @id // RR-<SupplierCode>-NNN
  purchaseId    String
  purchase      Purchase             @relation(fields: [purchaseId], references: [id])
  supplierId    String
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  sareeLineId   String
  sareeLine     PurchaseSareeLine    @relation(fields: [sareeLineId], references: [id])
  quantity      Int
  reason        String?
  status        SupplierReturnStatus @default(PENDING)
  requestedById String
  requestedBy   User                 @relation("RequestedSupplierReturns", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?                @relation("DecidedSupplierReturns", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime             @default(now())

  @@index([status])
  @@index([purchaseId])
  @@index([supplierId])
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  poNumber          String              @unique // PO-2026-NNN
  vendorId          String
  vendor            Vendor              @relation(fields: [vendorId], references: [id])
  deliveryDate      DateTime?
  totalValue        Decimal             @db.Decimal(12, 2)
  urgency           String?
  status            PurchaseOrderStatus @default(PENDING)
  // Which of the company's legal firms this order is raised under. Copied
  // onto the GrnReceipt when the goods are received, so Goods Receipt
  // History can show a real firm name instead of a blank column.
  firmId            String?
  firm              Firm?               @relation(fields: [firmId], references: [id])
  grnId             String? // display code, kept for backward compatibility
  grnReceiptId      String? // real FK to GrnReceipt.id, once GRN is received
  grnReceipt        GrnReceipt?         @relation(fields: [grnReceiptId], references: [id])
  actualReceivedDate DateTime? // stamped on receiveGrn(); compare against deliveryDate for on-time-delivery
  rejectionReason   String?
  createdAt         DateTime            @default(now())
  createdById       String?
  createdBy         User?               @relation(fields: [createdById], references: [id])

  items PurchaseOrderItem[]
  vendorBills VendorBill[]

  @@index([vendorId])
  @@index([status])
  @@index([grnReceiptId])
}

// Amount owed to a vendor — generated from a received PO/GRN, or entered
// manually for recurring items (rent, services, etc.). VendorPayment rows
// optionally settle against a bill (partial or full); status is derived
// from the sum of linked payments vs amount, recomputed on each payment.
model VendorBill {
  id            String           @id @default(uuid())
  vendorId      String
  vendor        Vendor           @relation(fields: [vendorId], references: [id])
  poId          String?
  purchaseOrder PurchaseOrder?   @relation(fields: [poId], references: [id])
  amount        Decimal          @db.Decimal(12, 2)
  dueDate       DateTime?
  status        VendorBillStatus @default(PENDING)
  description   String?
  createdAt     DateTime         @default(now())

  payments VendorPayment[]

  @@index([vendorId])
  @@index([poId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialType    MaterialType
  name            String
  // Color/grade/quality notes entered on the PO — distinct from `name`
  // (the material's short label). Carried through to the received GrnItem
  // (see GrnItem.description) so it stays visible on the receiving screen,
  // receipt history, and printed batch labels.
  description     String?
  quantity        Decimal       @db.Decimal(12, 3)
  unit            String        @default("KG")
  unitPrice       Decimal?      @db.Decimal(12, 2)
  totalPrice      Decimal?      @db.Decimal(12, 2)
  // Set from the vendor's real bill once one is raised — separate from
  // unitPrice/totalPrice above, which stay the original PO-time estimate.
  // Entered per-material in the Payments "Add/Edit Invoice" flow.
  invoicedAmount  Decimal?      @db.Decimal(12, 2)

  @@index([purchaseOrderId])
}

model PurchaseRequest {
  id              String                @id @default(uuid())
  supplierId      String?
  supplier        Supplier?             @relation(fields: [supplierId], references: [id])
  requestedById   String
  requestedBy     User                  @relation("RequestedBy", fields: [requestedById], references: [id])
  sareeType       String?
  quantity        Int
  estimatedAmount Decimal?              @db.Decimal(12, 2)
  urgency         String?
  reason          String?
  status          PurchaseRequestStatus @default(PENDING)
  decidedById     String?
  decidedBy       User?                 @relation("DecidedBy", fields: [decidedById], references: [id])
  decidedDate     DateTime?
  decisionNote    String?
  createdAt       DateTime              @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Firms & finance
// ─────────────────────────────────────────────────────────────────────────

model Firm {
  id                 String   @id @default(uuid())
  firmName           String
  gstNumber          String?
  address            String?
  purchaseAmount     Decimal? @db.Decimal(14, 2)
  accountNumber      String?
  ifscCode           String?
  bankName           String?
  contactPersonName  String?
  contactPersonPhone String?
  createdAt          DateTime @default(now())

  financialEntries FirmFinancialEntry[]
  weaverPayments   WeaverPayment[]
  vendorPayments   VendorPayment[]
  supplierPayments SupplierPayment[]
  invoicePayments  InvoicePayment[]
  quotations       Quotation[]
  dispatchRecords  DispatchRecord[]
  grnReceipts      GrnReceipt[]
  purchaseOrders   PurchaseOrder[]
}

model FirmFinancialEntry {
  id          String             @id @default(uuid())
  firmId      String
  firm        Firm               @relation(fields: [firmId], references: [id])
  kind        FinancialEntryKind
  category    String
  description String?
  amount      Decimal            @db.Decimal(12, 2)
  date        DateTime           @default(now())
  notes       String?

  @@index([firmId])
  @@index([kind])
}

model WeaverPayment {
  id          String   @id @default(uuid())
  weaverId    String
  weaver      Weaver   @relation(fields: [weaverId], references: [id])
  amountPaid  Decimal  @db.Decimal(12, 2)
  utrNumber   String?
  firmId      String?
  firm        Firm?    @relation(fields: [firmId], references: [id])
  paymentDate DateTime @default(now())
  uploadedAt  DateTime @default(now())
  batchNo     String?
  loomNumber  String?
  noOfSarees  Int?
  deduction   Decimal? @db.Decimal(12, 2)

  @@index([weaverId])
}

model VendorPayment {
  id       String      @id @default(uuid())
  vendorId String
  vendor   Vendor      @relation(fields: [vendorId], references: [id])
  amount   Decimal     @db.Decimal(12, 2)
  date     DateTime    @default(now())
  utr      String?
  method   String?
  firmId   String?
  firm     Firm?       @relation(fields: [firmId], references: [id])
  // Optional: links this payment to a specific bill it settles (partial or
  // full). When absent, the payment is a "general" vendor payment not tied
  // to any bill — existing behavior is unaffected.
  billId   String?
  bill     VendorBill? @relation(fields: [billId], references: [id])

  @@index([vendorId])
  @@index([billId])
}

model Invoice {
  id          String         @id @default(uuid())
  // Human-facing id (INV-<WholesaleCustomerCode>-NNN), distinct from `id`
  // (UUID) which stays the real FK target everywhere else — mirrors
  // Customer.code/FactoryLoom.code.
  code        String?        @unique
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  invoiceDate DateTime       @default(now())
  dueDate     DateTime?
  total       Decimal        @db.Decimal(12, 2)
  paid        Decimal        @default(0) @db.Decimal(12, 2)
  status      InvoiceStatus  @default(PENDING)
  dispatchId  String?        @unique
  dispatch    DispatchRecord? @relation(fields: [dispatchId], references: [id])

  payments InvoicePayment[]

  @@index([customerId])
  @@index([status])
}

model InvoicePayment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  utr       String?
  method    String?
  firmId    String?
  firm      Firm?    @relation(fields: [firmId], references: [id])

  @@index([invoiceId])
}

model Customer {
  id              String       @id @default(uuid())
  // Human-facing sequential id (e.g. "CUST-001" retail, "WHL-001" wholesale)
  // — generated via IdGeneratorService.nextFormatted, distinct from `id`
  // (UUID), which stays the real FK target everywhere else.
  code            String?      @unique
  name            String
  contactName     String?
  city            String?
  phone           String?
  address         String?
  gstCode         String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  type            CustomerType @default(RETAIL)
  visitingCardUrl String?
  whatsapp        String?
  state           String?
  paymentTerms    String?
  notes           String?
  createdAt       DateTime     @default(now())

  bulkOrders      BulkOrder[]
  dispatchRecords DispatchRecord[]
  invoices        Invoice[]
  quotations      Quotation[]
  sales           SaleRecord[]

  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────
// Labels — singleton shop-wide print/scan configuration
// ─────────────────────────────────────────────────────────────────────────

model LabelSettings {
  id                       String   @id @default(uuid())
  labelSize                String   @default("100mm × 50mm (Default)")
  showBarcode              Boolean  @default(true)
  showCode                 Boolean  @default(true)
  showWeaver               Boolean  @default(true)
  showDate                 Boolean  @default(true)
  showBranding             Boolean  @default(true)
  defaultPrinter           String   @default("TSC TE244")
  connectionType           String   @default("USB")
  scanShowPhoto            Boolean  @default(true)
  scanShowCode             Boolean  @default(true)
  scanShowWeaver           Boolean  @default(true)
  scanShowFabric           Boolean  @default(true)
  scanShowColour           Boolean  @default(true)
  scanShowJari             Boolean  @default(true)
  scanShowDispatchDate     Boolean  @default(true)
  scanShowProductionStatus Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Platform — audit, notifications
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  status     AuditStatus
  device     String?
  duration   Int?
  failReason String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ActionLog {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  role        UserRole
  module      String
  action      String
  entityType  String?
  entityId    String?
  recordLabel String?
  oldValue    String?
  newValue    String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model Notification {
  id         String                 @id @default(uuid())
  targetType NotificationTargetType
  userId     String?
  user       User?                  @relation(fields: [userId], references: [id])
  role       UserRole?
  type       String
  payload    Json?
  readAt     DateTime?
  createdAt  DateTime               @default(now())

  @@index([userId])
  @@index([role])
  @@index([readAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Raw Material Stock & GRNs
// ─────────────────────────────────────────────────────────────────────────

model RawMaterialStock {
  id           String       @id @default(uuid())
  materialType MaterialType
  name         String
  grade        String?
  color        String?
  unit         String       @default("KG")
  currentStock Decimal      @default(0) @db.Decimal(12, 3)
  reorderLevel Decimal      @default(10) @db.Decimal(12, 3)
  vendorId     String?
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([materialType])
}

model GrnReceipt {
  id           String    @id // GRN-2026-NNN
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  // Which of the company's legal firms this material was purchased for/by —
  // was previously always displayed as a hardcoded "Beere Kesava Silks
  // (Head Firm)" placeholder on the frontend with no real backing data.
  firmId       String?
  firm         Firm?     @relation(fields: [firmId], references: [id])
  supplierName String
  invoiceNo    String?
  invoiceDate  DateTime?
  receivedDate DateTime  @default(now())
  notes        String?
  createdAt    DateTime  @default(now())
  receivedById String?
  receivedBy   User?     @relation(fields: [receivedById], references: [id])

  items          GrnItem[]
  purchaseOrders PurchaseOrder[]
}

model GrnItem {
  id               String       @id @default(uuid())
  // Structured, human-facing id for this specific material line — printed on
  // its barcode label and shown in Goods Receipt History (e.g.
  // "GRN-SreeVignesh-004-002-1"), distinct from `id` (an internal uuid) and
  // from `grnId` (the parent receipt, which can carry several material
  // lines). Nullable because rows created before this field existed have
  // none — those fall back to a computed display value.
  itemCode         String?
  grnId            String
  grn              GrnReceipt   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  materialType     MaterialType
  name             String
  // Color/grade/quality notes — carried over from the PurchaseOrderItem this
  // was received against (see PurchaseOrderItem.description), or entered
  // directly for an ad-hoc receipt with no PO.
  description      String?
  grade            String?
  color            String?
  quantity         Decimal      @db.Decimal(12, 3)
  unit             String       @default("KG")
  unitPrice        Decimal      @db.Decimal(12, 2)
  totalPrice       Decimal      @db.Decimal(12, 2)
  rejectedQuantity Decimal      @default(0) @db.Decimal(12, 3)

  issuedItems MaterialIssueItem[]

  @@index([grnId])
}

// ─────────────────────────────────────────────────────────────────────────
// Workflows: Warp Requests & Rate Change Requests
// ─────────────────────────────────────────────────────────────────────────

model WarpRequest {
  id           String            @id // WR-2026-NNN
  weaverId     String
  weaver       Weaver            @relation(fields: [weaverId], references: [id])
  loomNumber   String?
  warpType     String
  lengthMeters Decimal           @db.Decimal(10, 2)
  color        String?
  status       WarpRequestStatus @default(PENDING)
  requestedAt  DateTime          @default(now())
  decidedAt    DateTime?
  decidedById  String?
  decidedBy    User?             @relation("DecidedWarpRequests", fields: [decidedById], references: [id])
  notes        String?

  materialIssue MaterialIssueRecord?

  @@index([weaverId])
  @@index([status])
}

model RateChangeRequest {
  id                String            @id // RCR-2026-NNN
  sareeTypeCode    String
  sareeType        SareeTypeRate     @relation(fields: [sareeTypeCode], references: [code])
  oldMakingCharge   Decimal           @db.Decimal(12, 2)
  newMakingCharge   Decimal           @db.Decimal(12, 2)
  oldRetailPrice    Decimal           @db.Decimal(12, 2)
  newRetailPrice    Decimal           @db.Decimal(12, 2)
  oldWholesalePrice Decimal           @db.Decimal(12, 2)
  newWholesalePrice Decimal           @db.Decimal(12, 2)
  status            RateRequestStatus @default(PENDING)
  reason            String?
  requestedById    String
  requestedBy      User              @relation("RequestedRateChanges", fields: [requestedById], references: [id])
  decidedById      String?
  decidedBy        User?             @relation("DecidedRateChanges", fields: [decidedById], references: [id])
  createdAt        DateTime          @default(now())
  decidedAt        DateTime?

  @@index([sareeTypeCode])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Reports — Scheduling & History
// ─────────────────────────────────────────────────────────────────────────

model ScheduledReport {
  id             String          @id @default(uuid())
  reportName     String
  frequency      ReportFrequency
  format         String          @default("PDF")
  recipientEmail String
  active         Boolean         @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime        @default(now())
}

model ReportDownloadHistory {
  id            String   @id @default(uuid())
  reportName    String
  fileType      String   @default("PDF")
  downloadUrl   String?
  downloadedById String?
  downloadedBy  User?    @relation(fields: [downloadedById], references: [id])
  downloadedAt  DateTime @default(now())
  filtersUsed   Json?

  @@index([downloadedAt])
}
