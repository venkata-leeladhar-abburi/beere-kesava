# Supabase pooler connection string, transaction mode (used by the app at runtime)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Supabase pooler connection string, session mode (used by `prisma migrate`/`db push`)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Long random string; the app refuses to boot in production without this set (see auth.module.ts)
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of allowed frontend origin(s), e.g. https://your-app.vercel.app
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"
PORT=3000

# --- Cloudflare R2 object storage (uploads: photos, signatures, LR receipts) ---
# Leave all of these unset to keep files on local disk under backend/uploads
# (fine for dev; on Render/containers local files are lost on every redeploy).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional: overrides https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
# Optional: public bucket / custom domain origin, e.g. https://cdn.example.com
# or https://pub-xxxx.r2.dev. Unset => reads go through 1-hour presigned URLs.
R2_PUBLIC_BASE_URL=""
