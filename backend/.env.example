# Supabase pooler connection string, transaction mode (used by the app at runtime)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Supabase pooler connection string, session mode (used by `prisma migrate`/`db push`)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Long random string; the app refuses to boot in production without this set (see auth.module.ts)
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of allowed frontend origin(s), e.g. https://your-app.vercel.app
CORS_ORIGIN="http://localhost:5173"

# Deployed frontend origin (single URL, no trailing slash) — used to build the
# /scan?id= link encoded into a saree tag's QR code. Optional; falls back to
# the local dev frontend when unset.
FRONTEND_URL="http://localhost:5175"

NODE_ENV="development"
PORT=3000

# --- Cloudflare R2 object storage (uploads: photos, signatures, LR receipts) ---
# Required — the app refuses to boot without these. Files must always live in
# the cloud, never on local disk.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional: overrides https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
# Optional: public bucket / custom domain origin, e.g. https://cdn.example.com
# or https://pub-xxxx.r2.dev. Unset => reads go through 1-hour presigned URLs.
R2_PUBLIC_BASE_URL=""

# ── WhatsApp / AiSensy ──────────────────────────────────────────────────────
# See guidelines/WHATSAPP_AISENSY_INTEGRATION.md. All optional: with
# WHATSAPP_ENABLED=false every send is recorded and skipped, so the app runs
# fine without an AiSensy account.
AISENSY_API_KEY=
AISENSY_SENDER_NAME=
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
WHATSAPP_ENABLED=false
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Comma-separated. Receives bk_admin_sale_alert_ on every counter sale and
# bk_report_share_ on every scheduled report. Bare 10-digit numbers are fine —
# WHATSAPP_DEFAULT_COUNTRY_CODE is prepended.
ADMIN_WHATSAPP_NUMBERS=
# Fills {{1}} of bk_admin_sale_alert_. Defaults to "Main Showroom".
SHOP_OUTLET_NAME=
