# Supabase pooler connection string, transaction mode (used by the app at runtime)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Supabase pooler connection string, session mode (used by `prisma migrate`/`db push`)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Long random string; the app refuses to boot in production without this set (see auth.module.ts)
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of allowed frontend origin(s), e.g. https://your-app.vercel.app
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"
PORT=3000
