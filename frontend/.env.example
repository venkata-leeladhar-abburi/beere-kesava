# Base URL of the backend API.
# Local dev: http://localhost:3000 (this file's default).
# Vercel Production env var: https://beere-kesava-backend.onrender.com
# Set per-environment in Vercel: Settings -> Environment Variables ->
# VITE_API_URL, with separate values for Production vs Development/Preview.
# This is a Vite build-time var, so changing it in Vercel requires a fresh
# build (not just promoting an existing deployment) to take effect.
VITE_API_URL="http://localhost:3000"

# Session storage. Leave unset (Bearer token in localStorage) until the app
# and the API share a site, e.g. app.example.com and api.example.com. Then set
# it to "cookie" so the session lives in an httpOnly cookie that page script
# cannot read. Build-time var, like VITE_API_URL. See docs/DEPLOY_RUNBOOK.md.
# VITE_AUTH_MODE="cookie"
